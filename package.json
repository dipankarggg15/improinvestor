    "seed:reviews": "tsx scripts/seed-reviews.ts",
    "seed:exits": "tsx scripts/seed-exits.ts",
    "seed:counterfactuals": "tsx scripts/seed-counterfactuals.ts",
    "verify:market": "tsx scripts/verify-market.ts",
    "validate:upstox": "tsx scripts/validate-upstox-provider.ts",
    "validate:upstox-sample": "tsx scripts/validate-upstox-sync-sample.ts",
    "sync:upstox": "tsx scripts/sync-upstox-market.ts",
    "schema:real-market": "tsx scripts/apply-real-market-schema.ts",
    "schema:historical-strategy": "tsx scripts/apply-historical-strategy-runner-schema.ts",
    "measure:market-storage": "tsx scripts/measure-market-storage.ts",
