# Supabase transaction pooler URL for normal application queries.
# For Vercel/serverless, use the Transaction pooler connection string from Supabase.
# Common Prisma/Supabase serverless parameters: pgbouncer=true&connection_limit=1
DATABASE_URL=

# Supabase direct connection URL for Prisma migrations and admin workflows.
# Paste the direct connection string here.
DIRECT_URL=

# Supabase Auth browser-safe project values.
# These are safe to expose to the browser; do not use the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Single-owner allowlist. Only this authenticated email may access the app.
OWNER_EMAIL=

UPSTOX_ACCESS_TOKEN=
MARKET_DATA_PROVIDER=mock
SYNTHETIC_MARKET_SEED=20260103
